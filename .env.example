# Optional: Telegram API credentials (get them from https://my.telegram.org)
# These can be configured from the web UI instead (Settings -> Telegram),
# where they are stored encrypted in the database. Values saved in the web UI
# take precedence over these; .env is only a fallback.
# API_ID=your_api_id_here
# API_HASH=your_api_hash_here

# Optional: chat ID to seed the monitored channel list (negative number for
# groups/channels). Channels are managed from the web UI (Settings -> Telegram)
# and stored in the database; this value is only used on first run.
# To get chat ID: forward a message from the chat to @userinfobot
# CHAT_ID=your_chat_id_here

# Download Directory
# Telegram files go to DOWNLOAD_DIR/Telegram, URL downloads go to DOWNLOAD_DIR/Videos
DOWNLOAD_DIR=/path/to/downloads

# Web Interface Configuration
WEB_PORT=4444
WEB_HOST=0.0.0.0

# Download Configuration
MAX_RETRIES=6

# PostgreSQL Database Configuration
# Create a dedicated user: CREATE USER telegram_user WITH PASSWORD 'your_password';
# Create database: CREATE DATABASE telegram_downloader OWNER telegram_user;
DATABASE_URL=postgresql://telegram_user:your_password@localhost:5432/telegram_downloader

# Application secret - signs login tokens (JWT) and encrypts secrets stored
# in the database (VPS/torrent passwords, Telegram API hash).
# Recommended: set it explicitly, e.g. with
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random secret is generated on first start and persisted to
# .jwt_secret (mode 0600) next to this file, then reused on later startups.
# Changing the secret logs everyone out (existing JWTs become invalid).
# JWT_SECRET=your_secret_key_here

# --- Session / token lifetimes ---------------------------------------------
# Access tokens are sent with every API call and are deliberately short-lived;
# the browser silently exchanges its refresh token for a new one. Refresh
# tokens are backed by a database row, so a session can be revoked instantly
# (logout, "sign out everywhere", or a password change).
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=30
# <video>/<img> tags can't send an auth header, so their URLs carry a separate
# token that only works on the streaming/thumbnail routes.
# MEDIA_TOKEN_HOURS=12

# --- CORS -------------------------------------------------------------------
# The web UI is served by this same process, so cross-origin access is normally
# unnecessary; the default only allows the Vite dev server (localhost:5173).
# Set this if you serve the frontend from another origin. Comma-separated.
# "*" is accepted but disables the protection - never on an exposed instance.
# CORS_ORIGINS=https://downlee.example.com

# --- Reverse proxy ----------------------------------------------------------
# Enable only when DownLee actually sits behind a proxy you control. It makes
# the app trust X-Forwarded-For for the client IP, which the login rate limiter
# keys off - if clients can reach the app directly, they can forge it.
# TRUST_PROXY_HEADERS=false
# TRUSTED_PROXY_COUNT=1

# --- Startup greeting -------------------------------------------------------
# The bot greets every monitored chat when it starts. To mute a single start:
#   touch .skip-greeting && sudo systemctl restart telegram-downloader
# (the file is consumed on startup, so only that one restart is silent).
# Running by hand:  python main.py --no-greeting
# Set this to mute it permanently:
# SKIP_STARTUP_GREETING=false
